<Project>
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_StorageLibrary)' == 'true'">
    <!-- Reference-only RBF1 libraries import their marker before this later SDK import. -->
    <IsPackable Condition="'$(_Rbf1ReferenceLibrary)' != 'true' and '$(StorageSourceOnly)' != 'true'">true</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Atelia storage foundations: $(MSBuildProjectName).</Description>
    <Authors>Atelia contributors</Authors>
  </PropertyGroup>
  <ItemGroup Condition="'$(_StorageLibrary)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- SDK 10.0.201 generates these three files with host newlines and localized comments.
       Normalize only these generated inputs during Pack, before the compiler/embedded-source reads them. -->
  <UsingTask TaskName="NormalizeStorageSdkGeneratedSources"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll"
             Condition="'$(StorageDeterministicPack)' == 'true' and '$(_StorageLibrary)' == 'true'">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ProjectDirectory ParameterType="System.String" Required="true" />
      <IntermediateDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        string intermediate = Path.GetFullPath(Path.Combine(ProjectDirectory, IntermediateDirectory));
        string boundary = intermediate.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
        if (Files.Length != 3) { throw new InvalidOperationException("Expected exactly three SDK-generated source inputs."); }
        foreach (var file in Files) {
            string path = Path.GetFullPath(Path.Combine(ProjectDirectory, file.ItemSpec));
            if (!path.StartsWith(boundary, StringComparison.Ordinal) || !path.EndsWith(".cs", StringComparison.Ordinal)) {
                throw new InvalidOperationException("SDK-generated source must stay in the intermediate directory: " + path);
            }
            string text = File.ReadAllText(path).Replace("\r\n", "\n").Replace("\r", "\n");
            // These SDK files contain only generated usings/assembly attributes and // comments.
            // Removing their blank/comment lines also handles stale localized outputs from an earlier build.
            string[] code = text.Split('\n').Where(line => !string.IsNullOrWhiteSpace(line) && !line.TrimStart().StartsWith("//", StringComparison.Ordinal)).ToArray();
            byte[] normalized = new UTF8Encoding(false).GetBytes("// <auto-generated/>\n" + string.Join("\n", code) + "\n");
            if (!File.ReadAllBytes(path).SequenceEqual(normalized)) { File.WriteAllBytes(path, normalized); }
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="NormalizeStorageSdkInputs"
          BeforeTargets="CoreCompile;_SetEmbeddedFilesFromSourceControlManagerUntrackedFiles"
          DependsOnTargets="GenerateGlobalUsings;GenerateAssemblyInfo;GenerateTargetFrameworkMonikerAttribute"
          Condition="'$(StorageDeterministicPack)' == 'true' and '$(_StorageLibrary)' == 'true'">
    <ItemGroup>
      <_StorageSdkGeneratedSource Include="$(GeneratedGlobalUsingsFile);$(GeneratedAssemblyInfoFile);$(TargetFrameworkMonikerAssemblyAttributesPath)" />
    </ItemGroup>
    <NormalizeStorageSdkGeneratedSources Files="@(_StorageSdkGeneratedSource)"
                                        ProjectDirectory="$(MSBuildProjectDirectory)"
                                        IntermediateDirectory="$(IntermediateOutputPath)" />
  </Target>
</Project>
