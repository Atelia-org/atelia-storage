<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Package mode relocates SDK output, so keep excluding source-mode outputs from default globs. -->
    <DefaultItemExcludes Condition="'$(StoragePackageMode)' == 'true'">$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo"><_Parameter1>Atelia.EventJournal.Validation</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Atelia.EventJournal.Toolkit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Atelia.RbfSegmentStore.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(StoragePackageMode)' != 'true'">
    <ProjectReference Include="..\Data\Data.csproj" />
    <ProjectReference Include="..\Primitives\Primitives.csproj" />
    <ProjectReference Include="..\Rbf\Rbf.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(StoragePackageMode)' == 'true'">
    <PackageReference Include="Atelia.Data" Version="$(StorageDependencyVersionData)" />
    <PackageReference Include="Atelia.Primitives" Version="$(StorageDependencyVersionPrimitives)" />
    <PackageReference Include="Atelia.Rbf" Version="$(StorageDependencyVersionRbf)" />
  </ItemGroup>

</Project>
