<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <ProjectReference Include="../../src/VersionStore/VersionStore.csproj" />
    <ProjectReference Include="../../tools/VersionStore.Smoke/VersionStore.Smoke.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyVersionStoreSmoke" AfterTargets="Build">
    <ItemGroup>
      <_VersionStoreSmokeFiles Include="$(MSBuildThisFileDirectory)../../tools/VersionStore.Smoke/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_VersionStoreSmokeFiles)" DestinationFolder="$(OutDir)VersionStore.Smoke" SkipUnchangedFiles="true" />
  </Target>
</Project>
