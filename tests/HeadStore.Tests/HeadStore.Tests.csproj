<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <StartupObject>Atelia.HeadStore.Tests.InternalProcess.InternalProcessHost</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <ProjectReference Include="../../src/HeadStore/HeadStore.csproj" />
    <ProjectReference Include="../../tools/HeadStore.Smoke/HeadStore.Smoke.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyHeadStoreSmoke" AfterTargets="Build">
    <ItemGroup>
      <_HeadStoreSmokeFiles Include="$(MSBuildThisFileDirectory)../../tools/HeadStore.Smoke/bin/$(Configuration)/$(TargetFramework)/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_HeadStoreSmokeFiles)" DestinationFolder="$(OutDir)HeadStore.Smoke" SkipUnchangedFiles="true" />
  </Target>
</Project>
